{
  "name": "causal/ig_ldap_sso_auth",
  "type": "typo3-cms-extension",
  "description": "LDAP / SSO Authentication - This extension provides LDAP support for TYPO3 by delegating the authentication of frontend and/or backend users to the centrally-managed directory of your organization. It fully supports OpenLDAP and Active Directory and is capable of connecting securely to the authentication server using either TLS or SSL (ldaps://). In case of use in an intranet environment, this extension is a perfect match since it natively brings Single Sign-On (SSO) capability to TYPO3 without any complex configuration.",
  "keywords": [
    "TYPO3 CMS",
    "OpenLDAP",
    "Active Directory",
    "LDAP",
    "Authentication"
  ],
  "support": {
    "docs": "https://docs.typo3.org/p/causal/ig_ldap_sso_auth/main/en-us/",
    "issues": "https://github.com/xperseguers/t3ext-ig_ldap_sso_auth/issues",
    "source": "https://github.com/xperseguers/t3ext-ig_ldap_sso_auth"
  },
  "authors": [
    {
      "name": "Xavier Perseguers",
      "email": "xavier@causal.ch",
      "homepage": "https://www.causal.ch",
      "role": "Developer"
    }
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1.0 <=8.5.99",
    "ext-ldap": "*",
    "ext-json": "*",
    "typo3/cms-core": "^12 || ^13 || ^14"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "~3.95.10",
    "phpstan/phpstan": "2.1.51",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "2.4.2"
  },
  "autoload": {
    "psr-4": {
      "Causal\\IgLdapSsoAuth\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Causal\\IgLdapSsoAuth\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.3.x-dev",
      "dev-3-8": "3.8.x-dev",
      "dev-3-3": "3.3.x-dev"
    },
    "typo3/cms": {
      "extension-key": "ig_ldap_sso_auth"
    }
  },
  "scripts": {
    "cs": [
      "./vendor/bin/php-cs-fixer fix -v --dry-run --config .php-cs-fixer.php"
    ],
    "csfix": [
      "./vendor/bin/php-cs-fixer fix -v --config .php-cs-fixer.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  }
}
